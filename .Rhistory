# coln2 <- paste0("f", country, "_ppi")             # Use for foreign prices converted in national currency terms (PPI * ER).
ExchangeRate <- data[coln2]
coln3 <- paste0(country, "_ppi")
PPI <- data[coln3]
OilPrice <- data["oil"]
df <- as.data.frame(cbind(date, Value, ExchangeRate, PPI, OilPrice))
colnames(df) <- c("date", "Value", "ExchangeRate", "PPI", "OilPrice")
df$Lag_Value <- Lag(df$Value, +1)
df <- df %>% na.omit
return(df)
#r1 <- lm(Value ~ Lag_Value + ExchangeRate + PPI + OilPrice)
}
linear_estimation("jp", "us", "xp", rdf)
linear_estimation <- function(country, counter_country, xpmp, data){
date <- data["date"]
coln1 <- paste0(country, "_", xpmp)
Value <- data[coln1]
# coln2 <- paste0(counter_country, country)         # Use for nominal exchange rate (ER)
coln2 <- paste0("r_", counter_country, country)   # Use for real exchange rate (ER * PPIj / PPIi)
# coln2 <- paste0("f", country, "_ppi")             # Use for foreign prices converted in national currency terms (PPI * ER).
ExchangeRate <- data[coln2]
coln3 <- paste0(country, "_ppi")
PPI <- data[coln3]
OilPrice <- data["oil"]
df <- as.data.frame(cbind(date, Value, ExchangeRate, PPI, OilPrice))
colnames(df) <- c("date", "Value", "ExchangeRate", "PPI", "OilPrice")
df$Lag_Value <- Lag(df$Value, +1)
df <- df %>% na.omit
r1 <- lm(Value ~ Lag_Value + ExchangeRate + PPI + OilPrice, data = df)
return(r1)
}
linear_estimation("jp", "us", "xp", rdf)
USXP <- linear_estimation("jp", "us", "xp", rdf)
USXP <- linear_estimation("jp", "us", "xp", rdf)
USMP <- linear_estimation("jp", "us", "mp", rdf)
JPXP <- linear_estimation("us", "jp", "xp", rdf)
JPMP <- linear_estimation("us", "jp", "mp", rdf)
stargazer(USXP, USMP, JPXP, JPMP, type = "text")
stargazer(USXP, USMP, JPXP, JPMP,
type = "text",
column.labels = c("US XP", "US MP", "JP XP", "JP MP"))
